{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "@franlol/opencode-md-table-formatter",
        "oc-codex-multi-auth"
    ],
    "server": {
        "cors": [
            "https://app.opencode.server.wg",
            "http://app.opencode.server.wg",
        ]
    },
    "autoupdate": true,
    "default_agent": "system-desing",
    "agent": {
        "plan": {
            "disable": true,
            "options": {},
            "permission": {}
        },
        "build": {
            "disable": true,
            "options": {},
            "permission": {}
        },
        "general": {
            "disable": true,
            "options": {},
            "permission": {}
        },
        "explore": {
            "disable": true,
            "options": {},
            "permission": {}
        }
    },
    "provider": {
        "openai": {
            "options": {
                "reasoningEffort": "medium",
                "reasoningSummary": "auto",
                "textVerbosity": "medium",
                "include": [
                    "reasoning.encrypted_content"
                ],
                "store": false
            }
        }
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true,
            "headers": {
                "CONTEXT7_API_KEY": "ctx7sk-896824b9-111a-4440-8f1b-7890d9d83447"
            }
        },
        "chunkhound": {
            "type": "local",
            "command": [
                "chunkhound",
                "mcp",
                "."
            ],
            "enabled": false,
            "timeout": 180000
        },
        "markitdown": {
            "type": "local",
            "command": [
                "markitdown-mcp"
            ],
            "enabled": true,
            "timeout": 180000
        },
        "word-document-server": {
            "type": "local",
            "command": [
                "uvx",
                "--from",
                "office-word-mcp-server",
                "word_mcp_server"
            ],
            "enabled": true,
            "timeout": 180000
        }
    }
}
